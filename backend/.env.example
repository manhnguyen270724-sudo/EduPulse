# ==============================================================================
# EDUPULSE PLATFORM — BACKEND ENVIRONMENT TEMPLATE
# Sao chép tệp này thành .env trong thư mục backend/ và điền thông tin thực tế
# ==============================================================================

# ── CẤU HÌNH MÁY CHỦ (SERVER CONFIG) ──
PORT=4400
CORS=*
FRONTEND_URL=http://localhost:5173

# ── CƠ SỞ DỮ LIỆU (MONGODB DATABASE) ──
DB_NAME=eLearning
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net

# ── BẢO MẬT & PHÂN QUYỀN (JWT AUTHENTICATION) ──
ACCESS_TOKEN_SECRET=your_jwt_access_token_secret_here
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=your_jwt_refresh_token_secret_here
REFRESH_TOKEN_EXPIRY=10d

# ── DỊCH VỤ EMAIL (NODEMAILER SMTP) ──
SMTP_EMAIL=your-email@gmail.com
SMTP_PASS=your-google-app-password

# ── LƯU TRỮ ĐÁM MÂY (CLOUDINARY STORAGE) ──
CLOUDINARY_NAME=your-cloudinary-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_SECRET_KEY=your-cloudinary-secret-key

# ── CỔNG THANH TOÁN (PAYMENT GATEWAY - RAZORPAY / VNPAY) ──
KEY_ID=rzp_test_your_key_id
KEY_SECRET=your_key_secret
