# ==============================================================================
# EDUPULSE PLATFORM — FRONTEND ENVIRONMENT TEMPLATE (VITE + REACT)
# Sao chép tệp này thành .env trong thư mục frontend/ và điền cấu hình
# Lưu ý: Tất cả biến môi trường cho Vite client BẮT BUỘC có tiền tố VITE_
# ==============================================================================

# ── ĐỊA CHỈ API BACKEND (Vite dev server sẽ proxy qua URL này) ──
VITE_API_BASE_URL=http://localhost:4400

# ── THÔNG TIN NỀN TẢNG (APPLICATION BRANDING) ──
VITE_APP_NAME=EduPulse
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Nền tảng học trực tuyến thông minh EduPulse
